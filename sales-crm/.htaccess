# Queue24 Sales CRM — lives in public_html/sales-crm (does not affect the main site)
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # private folders
  RewriteRule ^(app|data)(/|$) - [F,L]
  # API → front controller
  RewriteRule ^api(/.*)?$ api/index.php [QSA,L]
</IfModule>

# never serve config / database / backups directly
<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|db|log|md|sample|bak)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  # keep the CRM out of Google (searching "Queue24" shows only the main site)
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  Header always set X-Content-Type-Options "nosniff"
  # always revalidate app code so updates show up immediately
  <FilesMatch "\.(js|css|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType text/javascript .js
  AddType application/manifest+json .webmanifest
</IfModule>
